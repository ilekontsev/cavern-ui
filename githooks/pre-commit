#!/usr/bin/env bash
#
# Pre-commit hook.
# Проверяет только staged-файлы: форматирование, eslint, console.log,
# связанные тесты и сборку.
#
# Обойти (осознанно): git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

step() { printf "\n${YELLOW}==> %s${NC}\n" "$1"; }
fail() { printf "\n${RED}x %s${NC}\n" "$1" >&2; exit 1; }

# --- Собираем staged-файлы (без удалённых) ---
staged=()
while IFS= read -r f; do
	[ -n "$f" ] && staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#staged[@]} -eq 0 ]; then
	exit 0
fi

prettier_files=()
eslint_files=()
code_files=()

for f in "${staged[@]}"; do
	[ -f "$f" ] || continue

	case "$f" in
		*.ts | *.js | *.mjs | *.cjs | *.html | *.scss | *.css | *.sass | *.less | *.json | *.jsonc | *.md | *.yml | *.yaml)
			prettier_files+=("$f")
			;;
	esac

	case "$f" in
		*.ts | *.html)
			eslint_files+=("$f")
			;;
	esac

	case "$f" in
		*.ts | *.js | *.mjs | *.cjs)
			code_files+=("$f")
			;;
	esac
done

# --- 1. console.log / console.debug в добавляемых строках ---
step "Проверка console.log / console.debug"
console_hits=""
if [ ${#code_files[@]} -gt 0 ]; then
	console_hits=$(
		git diff --cached -U0 --no-color -- "${code_files[@]}" | awk '
			/^\+\+\+ b\// { file = substr($0, 7); next }
			/^@@ / {
				s = $0
				sub(/^@@ -[0-9,]+ \+/, "", s)
				sub(/,.*$/, "", s)
				line = s + 0
				next
			}
			/^\+/ {
				if ($0 ~ /console\.(log|debug)[[:space:]]*\(/) {
					body = substr($0, 2)
					printf "%s:%s: %s\n", file, line, body
				}
				line++
			}
		'
	)
fi

if [ -n "$console_hits" ]; then
	printf "%s\n" "$console_hits" >&2
	fail "Найдены console.log/console.debug. Убери их перед коммитом."
fi
echo "ok"

# --- 2. Prettier: форматируем и возвращаем в индекс ---
if [ ${#prettier_files[@]} -gt 0 ]; then
	step "Prettier: форматирую staged-файлы"
	npx prettier --write "${prettier_files[@]}" || fail "Prettier не смог отформатировать файлы"
fi

# --- 3. ESLint: исправляем и возвращаем в индекс ---
if [ ${#eslint_files[@]} -gt 0 ]; then
	step "ESLint: исправляю staged-файлы"
	npx eslint --fix -- "${eslint_files[@]}" || fail "ESLint: остались ошибки, которые нельзя исправить автоматически"
fi

if [ ${#prettier_files[@]} -gt 0 ] || [ ${#eslint_files[@]} -gt 0 ]; then
	git add -- "${prettier_files[@]}" "${eslint_files[@]}" 2>/dev/null
fi

# --- 4. Проверка форматирования после автофикса ---
if [ ${#prettier_files[@]} -gt 0 ]; then
	step "Prettier: проверка"
	npx prettier --check "${prettier_files[@]}" >/dev/null || fail "Форматирование не прошло"
	echo "ok"
fi

# --- 5. Тесты, связанные со staged-файлами ---
test_files=()
for f in "${staged[@]}"; do
	case "$f" in
		*.spec.ts | *.test.ts)
			[ -f "$f" ] && test_files+=("$f")
			continue
			;;
	esac

	case "$f" in
		*.ts)
			base="${f%.ts}"
			[ -f "$base.spec.ts" ] && test_files+=("$base.spec.ts")
			[ -f "$base.test.ts" ] && test_files+=("$base.test.ts")
			;;
	esac
done

if [ ${#test_files[@]} -gt 0 ]; then
	# Убираем дубликаты
	unique_tests=()
	while IFS= read -r t; do
		[ -n "$t" ] && unique_tests+=("$t")
	done < <(printf '%s\n' "${test_files[@]}" | sort -u)

	include_args=()
	for t in "${unique_tests[@]}"; do
		include_args+=(--include "$t")
	done

	step "Тесты: ${#unique_tests[@]} связанных файл(ов)"
	npx ng test --watch=false "${include_args[@]}" || fail "Тесты не прошли"
else
	step "Тесты: связанных spec-файлов нет, пропускаю"
fi

# --- 6. Полная сборка ---
step "Сборка"
npx ng build || fail "Билд не прошёл"

printf "\n${GREEN}v Все проверки пройдены${NC}\n"

#!/usr/bin/env bash
#
# Commit-msg hook.
# Требует формат: <префикс>/cavern-<номер>. <описание>
# Обойти (осознанно): git commit --no-verify

msg_file="$1"
msg=$(head -n 1 "$msg_file" | tr -d '\r')

# Стандартные служебные сообщения не проверяем
case "$msg" in
	Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$msg" | grep -Eq '^(bug|ui-kit|feature|story|fix|docs|style|refactor|config)/cavern-[0-9]+\. .+'; then
	cat >&2 <<'EOF'

x Неверный формат сообщения коммита.

Ожидается:
  <префикс>/cavern-<номер>. <описание>

Префиксы: bug, feature, story, fix, docs, style, refactor, config.

Примеры:
  bug/cavern-123. Исправлена авторизация
  feature/cavern-124. Добавлен экран профиля
  docs/cavern-125. Описана установка

EOF
	exit 1
fi
